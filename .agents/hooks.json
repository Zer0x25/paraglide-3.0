{
  "db-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/scripts/guard-dev-db.mjs\" --host antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
